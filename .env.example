# FOLIO — Environment Configuration Template
# Copy this file to .env for local/production deployment

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=folio-grants
PINECONE_NAMESPACE=folio-doc

# Legacy / Alternative API Endpoints
EMBEDDING_API_KEY=your_openrouter_api_key_here
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

# Streamlit Runtime Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
