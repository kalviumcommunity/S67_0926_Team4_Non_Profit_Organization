# FOLIO — Environment Configuration Template
# Copy this file to .env for production deployment

# RAG & Document Intelligence API Backend
RAG_API_URL=https://api.folio-intel.internal/v1
RAG_API_KEY=your_rag_api_key_here
DOCUMENT_API_URL=https://api.folio-intel.internal/v1/documents

# Streamlit Runtime Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=folio
PINECONE_NAMESPACE=
