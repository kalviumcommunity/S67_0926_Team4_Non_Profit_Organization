# FOLIO — Environment Configuration Template
# Copy this file to .env for production deployment

# RAG & Document Intelligence API Backend
RAG_API_URL=http://localhost:8000
RAG_API_KEY=your_rag_api_key_here
DOCUMENT_API_URL=http://localhost:8000/documents

# Streamlit Runtime Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# OpenRouter & LLM API Access
OPENROUTER_API_KEY=your_openrouter_api_key_here
Open_router_API_KEY=your_openrouter_api_key_here

# Embedding API Configuration
EMBEDDING_API_KEY=your_openrouter_api_key_here
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=folio
PINECONE_NAMESPACE=

